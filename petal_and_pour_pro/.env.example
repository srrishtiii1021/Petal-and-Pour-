# Copy this file to .env and replace every placeholder.
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=1

# PostgreSQL example:
DATABASE_URL=postgresql+psycopg://petal_user:strong_password@localhost:5432/petal_cafe
# For a quick local-only test, SQLite is also supported:
# DATABASE_URL=sqlite:///petal_and_pour_dev.db

CAFE_NAME=Petal & Pour
CAFE_SEAT_CAPACITY=30

# Razorpay TEST credentials only while developing.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# First admin account; use a unique strong password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password
